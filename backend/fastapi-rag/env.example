# OpenAI Configuration
OPENAI_API_KEY=your_openai_key_here
EMBEDDING_MODEL=text-embedding-ada-002
GENERATION_MODEL=gpt-4o-mini
# Hard cap on tokens billed per answer (also clamped to 1500 in code)
MAX_TOKENS=600

# RAG Configuration
RAG_NAMESPACE=miguel
TOP_K=6

# CORS: comma-separated allow-list of browser origins. Do NOT use "*".
CORS_ORIGINS=https://mrparracho.github.io,http://localhost:3000,http://127.0.0.1:3000

# Rate limits (per client IP)
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_TTS=20/minute
RATE_LIMIT_STT=20/minute

# Input guards
MAX_QUESTION_CHARS=1000
MAX_TTS_CHARS=1500
MAX_AUDIO_BYTES=10485760

# ElevenLabs (server-side only — never exposed to the browser)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=foB7BprNxwUpIFQmq811
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
