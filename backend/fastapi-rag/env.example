# ==============================================================================
# Environment configuration
#
# Only the two REQUIRED keys below must be set. Everything under OPTIONAL has a
# working default baked into app/config.py — set those only to override.
# (Do NOT set PORT — the host, e.g. Render, injects it and start.sh reads $PORT.)
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------

# Required for chat / RAG answers (POST /ask). Without it, /ask returns HTTP 500.
OPENAI_API_KEY=

# Required for voice (POST /tts and /stt). Without it, those return HTTP 503
# and the site shows "Voice not available". Server-side only — never exposed
# to the browser.
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — defaults shown; uncomment/change only to override
# ------------------------------------------------------------------------------

# OpenAI / RAG
# EMBEDDING_MODEL=text-embedding-ada-002
# GENERATION_MODEL=gpt-4o-mini
# RAG_NAMESPACE=miguel
# TOP_K=6
# Hard cap on tokens billed per answer (also clamped to 1500 in code)
# MAX_TOKENS=600

# ElevenLabs voice/model (server-side only)
# ELEVENLABS_VOICE_ID=foB7BprNxwUpIFQmq811
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1

# CORS: comma-separated allow-list of browser origins. Do NOT use "*".
# The default already covers the live site + local dev, so this is optional,
# but setting it explicitly in production is recommended. It MUST include your
# site's origin (https://mrparracho.github.io) or browsers will block requests.
# CORS_ORIGINS=https://mrparracho.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Rate limits (per client IP)
# RATE_LIMIT_ASK=10/minute
# RATE_LIMIT_TTS=20/minute
# RATE_LIMIT_STT=20/minute

# Input guards
# MAX_QUESTION_CHARS=1000
# MAX_TTS_CHARS=1500
# MAX_AUDIO_BYTES=10485760
